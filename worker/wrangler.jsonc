{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dioramha-assistant",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "ai": { "binding": "AI" },
  "vars": { "MODEL": "@cf/openai/gpt-oss-120b" },
  // Request bodies describe people's homes: never keep them in logs.
  "observability": { "enabled": false }
}
